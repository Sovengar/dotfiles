{
  "layer": "top",
  "output": ["*"],
  "exclusive": true,
  "passthrough": false,
  "margin": "5",
  "reload_style_on_change": true,
  "include": [
    "$XDG_CONFIG_HOME/waybar/modules/group-mediaplayer.jsonc", 
    "$XDG_CONFIG_HOME/waybar/modules/custom-weather.jsonc",
    "$XDG_CONFIG_HOME/waybar/modules/hardware.jsonc",
    "$XDG_DATA_HOME/waybar/modules/custom-network.jsonc",
    "$XDG_DATA_HOME/waybar/modules/custom-thermals.jsonc",
    // "$XDG_DATA_HOME/waybar/modules/*json*" 
    "includes/includes.json" 
  ],
  // ? Groups per side
  "modules-left": ["group/leaf-inverse", "custom/media-gap-left", "group/khing-mediaplayer", "custom/media-gap-right"],
  "modules-center": ["group/pill-in#center"],
  "modules-right": ["group/leaf"],
  //  ? Declaring the groups
  "group/leaf-inverse": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces"]
  },
  "group/pill-in#center": {
    "orientation": "inherit",
    "modules": [
      "custom/weather",
      "clock#date"
    ]
  },
  "clock#date": {
    "format": "{:%a. %d %b %H:%M}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "group/misc": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": "0.5",
      "children-class": "misc-drawer",
      "transition-left-to-right": true,
      "click-to-reveal": true
    },
    "modules": [
      "custom/misc",
      "keyboard-state",
      "custom/updates",
      "custom/keybindhint",
      "custom/gamemode",
      "custom/mise",
      "custom/hyprsunset",
      "idle_inhibitor",
      "tray"
    ]
  },
  "custom/misc": {
    "format": "󰒓 Misc",
    "tooltip": true,
    "tooltip-format": "Mostrar miscelánea"
  },
  "custom/mise": {
    "format": "󱁤",
    "tooltip": true,
    "tooltip-format": "Gestionar Mise",
    "on-click": "$XDG_CONFIG_HOME/waybar/scripts/waybar-mise-menu"
  },
  "group/leaf": {
    "orientation": "inherit",
    "modules": [
      "group/audio",
      "privacy",
      "backlight",
      "custom/network",
      "bluetooth",
      "battery",
      "power-profiles-daemon",
      "group/hardware",
      "group/thermals",
      "custom/clipboard",
      "custom/swaync",
      "custom/dunst",
      "group/misc",
      "custom/hyde-menu"
    ]
  },
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": "0.5",
      "children-class": "hardware-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": ["custom/hardware", "cpu", "memory"]
  },
  "group/thermals": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": "0.5",
      "children-class": "thermals-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": [
      "custom/thermals",
      "custom/gpuinfo",
      "custom/cpuinfo",
      "custom/sensorsinfo"
    ]
  },
  "group/audio": {
    "orientation": "inherit",
    "modules": ["pulseaudio#microphone", "pulseaudio", "pulseaudio/slider"]
  }
}
