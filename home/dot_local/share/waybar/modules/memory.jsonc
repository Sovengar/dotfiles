{
  "memory": {
    "states": {
      "c": 90,
      "h": 60,
      "m": 30
    },
    "interval": 30,
    "format": " {percentage}%",
    "format-discharging": "",
    "rotate": 0,
    "on-click": "kitty btop",
    "max-length": 10,
    "tooltip": true,
    "tooltip-format": " Memory usage: {percentage}%\n  Used: {used:0.2f}GB / {total:0.2f}GB\n  Available: {avail:0.2f}GB"
  }
}
