#!/usr/bin/env bash
# =============================================================================
#  sftp-gui-client
#  Monta un servidor por SFTP (GVfs) y lo deja navegable en Thunar,
#  con un bookmark con nombre bonito que abre directamente en su home.
#
#  Pasos que ejecuta:
#   1. Comprueba el stack SFTP/GVfs + Thunar (e instala gvfs si falta)
#   2. Asegura el alias del servidor en /etc/hosts
#   3. Acepta la host key del servidor
#   4. Prueba la conectividad SSH sin GUI (clave, sin password)
#   5. Monta sftp://usuario@alias/home  (gvfs)
#   6. Desmonta montajes viejos por IP
#   7. Verifica que se pueden listar los ficheros
#   8. Crea/actualiza el bookmark "alias" en Thunar  -> abre en el home
#   9. (opcional) Oculta la entrada fea "/ en <host>" del panel de Thunar
#  10. Abre Thunar en el home remoto
#
#  Uso:
#    sftp-gui-client              # todo el proceso
#    sftp-gui-client --status     # solo comprueba estado
#    sftp-gui-client --unmount    # desmonta y quita el bookmark
#    sftp-gui-client --no-open    # todo menos abrir Thunar
#    sftp-gui-client --keep-entry # no oculta la entrada "/ en <host>"
#    sftp-gui-client -h|--help
# =============================================================================

set -uo pipefail

# ----------------------------- configuración --------------------------------
HOST_ALIAS="${SFTP_HOST_ALIAS:-whitepc}"          # nombre bonito (en /etc/hosts)
HOST_IP="${SFTP_HOST_IP:-192.168.18.57}"          # IP real del servidor
REMOTE_USER="${SFTP_USER:-buble}"                 # usuario en el servidor
REMOTE_PORT="${SFTP_PORT:-22}"                    # puerto SSH
REMOTE_HOME="${SFTP_HOME:-/home/buble}"           # carpeta de destino
BOOKMARK_NAME="${SFTP_BOOKMARK:-$HOST_ALIAS}"     # nombre del bookmark en Thunar

BOOKMARKS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/bookmarks"
KNOWN_HOSTS="$HOME/.ssh/known_hosts"
GVFS_RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gvfs"
XFCONF_CHANNEL="thunar"
XFCONF_PROP="/hidden-devices"

URI="sftp://${REMOTE_USER}@${HOST_ALIAS}${REMOTE_HOME}"
ROOT_URI="sftp://${REMOTE_USER}@${HOST_ALIAS}/"
IP_ROOT_URI="sftp://${REMOTE_USER}@${HOST_IP}/"

# ------------------------------- utilidades ---------------------------------
if [ -t 1 ]; then
  C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_B=$'\033[1m'; C_0=$'\033[0m'
else
  C_G=''; C_Y=''; C_R=''; C_B=''; C_0=''
fi

step() { printf '\n%s==>%s %s%s%s\n' "$C_B" "$C_0" "$C_B" "$*" "$C_0"; }
ok()    { printf '  %s[ok]%s %s\n' "$C_G" "$C_0" "$*"; }
info()  { printf '  %s[..]%s %s\n' "$C_Y" "$C_0" "$*"; }
warn()  { printf '  %s[!!]%s %s\n' "$C_R" "$C_0" "$*"; }
die()   { printf '\n%sERROR:%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 1; }

# pregunta al usuario (si no hay tty, no bloquea y responde "no")
ask() {  # ask "texto" -> 0 = sí
  local prompt="$1"
  if [ ! -t 0 ]; then return 1; fi
  printf '  %s[?]%s %s [s/N] ' "$C_Y" "$C_0" "$prompt"
  local r; read -r r
  case "$r" in s|S|si|SI|sí|Sí|y|Y|yes) return 0 ;; *) return 1 ;; esac
}

# ------------------------------- opciones -----------------------------------
DO_ALL=1; DO_OPEN=1; DO_HIDE=1; DO_MOUNT=1
for arg in "$@"; do
  case "$arg" in
    --status)         DO_ALL=0; MODE=status ;;
    --unmount)        DO_ALL=0; MODE=unmount ;;
    --no-open)        DO_OPEN=0 ;;
    --keep-entry)     DO_HIDE=0 ;;
    -h|--help)        awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *)                die "opción desconocida: $arg (usa --help)" ;;
  esac
done
MODE="${MODE:-run}"

# ------------------------- 1. dependencias / gvfs ---------------------------
have() { command -v "$1" >/dev/null 2>&1; }
gvfs_sftp_present() {
  local p
  for p in /usr/lib/gvfsd-sftp /usr/lib64/gvfsd-sftp \
           /usr/lib/gvfs/gvfsd-sftp /usr/libexec/gvfsd-sftp \
           /usr/lib/x86_64-linux-gnu/gvfs/gvfsd-sftp; do
    [ -x "$p" ] && return 0
  done
  have gvfsd-sftp && return 0
  return 1
}

install_gvfs() {
  info "el backend sftp de GVfs no está instalado"
  have pacman && cmd=(sudo pacman -S --needed --noconfirm gvfs)
  have apt-get && cmd=(sudo apt-get install -y gvfs-backends)
  have dnf && cmd=(sudo dnf install -y gvfs)
  have zypper && cmd=(sudo zypper --non-interactive install gvfs)
  [ -n "${cmd:-}" ] || die "no sé qué gestor de paquetes usar; instala 'gvfs' a mano"
  ask "¿Instalo gvfs ahora? (${cmd[*]})" || die "instálalo con: ${cmd[*]}"
  info "ejecutando: ${cmd[*]}"
  "${cmd[@]}" || die "falló la instalación de gvfs"
  gvfs_sftp_present || die "gvfs instalado pero sigo sin ver gvfsd-sftp"
  ok "gvfs instalado"
}

check_deps() {
  step "1. Stack SFTP/GVfs + Thunar"
  have ssh     || die "falta 'ssh' (openssh)"
  have gio     || die "falta 'gio' (glib2)"
  have thunar  || die "falta 'thunar'"
  ok "ssh: $(ssh -V 2>&1 | head -1)"
  ok "thunar: $(thunar --version 2>/dev/null | head -1 | awk '{print $1, $2, $3}')"
  if gvfs_sftp_present; then
    ok "backend sftp de gvfs presente"
  else
    install_gvfs
  fi
}

# ----------------------------- 2. /etc/hosts --------------------------------
check_hosts() {
  step "2. Alias del servidor (${HOST_ALIAS} -> ${HOST_IP})"
  local resolved
  resolved="$(getent hosts "$HOST_ALIAS" 2>/dev/null | awk '{print $1}' | head -1)"
  if [ "$resolved" = "$HOST_IP" ]; then
    ok "/etc/hosts ya resuelve $HOST_ALIAS -> $HOST_IP"
    return
  fi
  if [ -n "$resolved" ]; then
    warn "$HOST_ALIAS ya apunta a $resolved (distinto de $HOST_IP)"
    ask "¿Sobrescribir añadiendo '$HOST_IP $HOST_ALIAS' a /etc/hosts?" || return 0
  else
    info "$HOST_ALIAS no resuelve todavía"
    ask "¿Añado '$HOST_IP $HOST_ALIAS' a /etc/hosts?" || die "sin alias no puedo usar el nombre bonito"
  fi
  printf '%s %s\n' "$HOST_IP" "$HOST_ALIAS" | sudo tee -a /etc/hosts >/dev/null \
    || die "no pude escribir en /etc/hosts"
  ok "alias añadido a /etc/hosts"
}

# ----------------------------- 3. host key ----------------------------------
check_hostkey() {
  step "3. Host key de $HOST_ALIAS"
  if ssh-keygen -F "$HOST_ALIAS" >/dev/null 2>&1; then
    ok "host key ya conocida para $HOST_ALIAS"
    return
  fi
  info "escaneando clave pública del servidor..."
  local keys
  keys="$(ssh-keyscan -T 10 -p "$REMOTE_PORT" "$HOST_ALIAS" 2>/dev/null | grep -E '^(ssh|ecdsa|sk-)' || true)"
  [ -n "$keys" ] || die "no puedo contactar con $HOST_ALIAS:$REMOTE_PORT para leer su host key"
  mkdir -p "$(dirname "$KNOWN_HOSTS")"; touch "$KNOWN_HOSTS"; chmod 600 "$KNOWN_HOSTS"
  printf '%s\n' "$keys" >> "$KNOWN_HOSTS"
  ok "host key añadida a ~/.ssh/known_hosts"
}

# --------------------------- 4. conectividad SSH ----------------------------
check_ssh() {
  step "4. Conectividad SSH ($REMOTE_USER@$HOST_ALIAS:$REMOTE_PORT)"
  if ssh -o BatchMode=yes -o ConnectTimeout=5 -p "$REMOTE_PORT" \
         "$REMOTE_USER@$HOST_ALIAS" 'echo ok' >/dev/null 2>&1; then
    ok "autenticación por clave funcionando (sin password)"
    return
  fi
  warn "BatchMode falló (clave no aceptada, 2FA, o servidor caído)"
  info "prueba interactiva: ssh -p $REMOTE_PORT $REMOTE_USER@$HOST_ALIAS"
  if [ -t 0 ] && ask "¿Abro una sesión SSH interactiva ahora para aceptarla?"; then
    ssh -p "$REMOTE_PORT" "$REMOTE_USER@$HOST_ALIAS" || true
    ssh -o BatchMode=yes -o ConnectTimeout=5 -p "$REMOTE_PORT" \
        "$REMOTE_USER@$HOST_ALIAS" 'echo ok' >/dev/null 2>&1 \
      || die "sigue sin funcionar sin password; GVfs necesita clave o agente SSH"
    ok "autenticación por clave funcionando"
    return
  fi
  die "no puedo continuar sin clave SSH (GVfs no puede teclear la password)"
}

# ------------------------------- 5. montaje ---------------------------------
already_mounted() {
  gio mount -l 2>/dev/null | grep -qF -- "-> $ROOT_URI"
}

do_mount() {
  step "5. Montaje GVfs ($URI)"
  if already_mounted; then
    ok "ya estaba montado"
  else
    info "montando..."
    if ! gio mount "$URI" 2>&1 | sed 's/^/     /'; then
      die "falló el montaje de $URI"
    fi
    already_mounted || die "gio mount devolvió 0 pero no aparece el montaje"
    ok "montado"
  fi

  # montajes viejos por IP -> desmontar (evita duplicados feos)
  if gio mount -l 2>/dev/null | grep -qF -- "-> $IP_ROOT_URI"; then
    info "desmontando la entrada antigua por IP ($IP_ROOT_URI)"
    gio mount -u "$IP_ROOT_URI" >/dev/null 2>&1 && ok "desmontada"
  fi
}

# ------------------------------- 6. verificación ----------------------------
fuse_path() {
  local d
  for d in "$GVFS_RUN_DIR"/sftp:host=*; do
    [ -d "$d" ] || continue
    case "$d" in *"host=$HOST_ALIAS,"*|*"host=$HOST_ALIAS") printf '%s\n' "$d"; return 0 ;; esac
  done
  return 1
}

verify_mount() {
  step "6. Verificación de lectura"
  local n
  if ! n="$(gio list "$URI" 2>/dev/null | wc -l)" || [ "$n" -eq 0 ]; then
    die "gio list no puede leer $URI"
  fi
  ok "gio list $URI -> $n entradas"
  local fp
  if fp="$(fuse_path)"; then
    ok "ruta FUSE: $fp$REMOTE_HOME"
    [ -d "$fp$REMOTE_HOME" ] && ok "home remoto visible ($(ls "$fp$REMOTE_HOME" | wc -l) elementos)"
  fi
  gio mount -l -i 2>/dev/null | awk -v u="$ROOT_URI" 'index($0,u)>0{p=1} p&&/default_location/{print "     "$0; exit}'
}

# -------------------------------- 7. bookmark -------------------------------
ensure_bookmark() {
  step "7. Bookmark de Thunar (\"$BOOKMARK_NAME\")"
  mkdir -p "$(dirname "$BOOKMARKS_FILE")"
  [ -e "$BOOKMARKS_FILE" ] || : > "$BOOKMARKS_FILE"

  # quita líneas previas del mismo URI y añade la nueva con el nombre pedido
  local tmp
  tmp="$(mktemp)" || die "no puedo crear fichero temporal"
  awk -v u="$URI" 'index($0, u) != 1' "$BOOKMARKS_FILE" > "$tmp"
  printf '%s %s\n' "$URI" "$BOOKMARK_NAME" >> "$tmp"
  mv "$tmp" "$BOOKMARKS_FILE"
  ok "$BOOKMARKS_FILE -> \"$BOOKMARK_NAME\" = $URI"
}

# ------------------- 8. ocultar la entrada "/ en <host>" --------------------
# Thunar nombra el montaje remoto como "<path> en <hostname>"
# (thunar_g_file_get_display_name_remote) => "/ en 192.168.18.57".
# Eso viene de g_mount_get_name(), que es con lo que compara hidden-devices.
mount_display_name() {
  gio mount -l 2>/dev/null | awk -v u="$ROOT_URI" '
    index($0, "-> " u) > 0 {
      sub(/^Mount[(][0-9]+[)]: /, ""); sub(/ -> .*/, ""); print; exit
    }'
}

hidden_devices_list() {
  # xfconf imprime "El valor es un vector con N elementos:" + línea en blanco
  local out
  out="$(xfconf-query -c "$XFCONF_CHANNEL" -p "$XFCONF_PROP" 2>/dev/null || true)"
  [ -n "$out" ] || return 0
  if printf '%s\n' "$out" | head -1 | grep -q 'vector con'; then
    printf '%s\n' "$out" | sed '1d' | sed '1{/^$/d}'
  else
    printf '%s\n' "$out"
  fi
}

hide_ugly_entry() {
  step "8. Entrada \"... en $HOST_ALIAS\" del panel lateral"
  have xfconf-query || { warn "xfconf-query no está: no puedo ocultarla (puedes ignorarlo)"; return 0; }

  local name cur
  name="$(mount_display_name)"
  if [ -z "$name" ]; then
    warn "no encuentro el nombre del montaje; no hago nada"
    return 0
  fi
  info "nombre de la entrada: \"$name\""

  cur="$(hidden_devices_list)"
  if printf '%s\n' "$cur" | grep -Fxq -- "$name"; then
    ok "ya estaba oculta en el panel"
    return 0
  fi

  # xfconf-query: un -t por cada -s; -a crea el vector con un solo elemento
  local -a args=() v
  while IFS= read -r v; do
    [ -n "$v" ] || continue
    args+=(-t string -s "$v")
  done <<< "$cur"
  args+=(-t string -s "$name")

  if xfconf-query -c "$XFCONF_CHANNEL" -p "$XFCONF_PROP" -n "${args[@]}"; then
    ok "oculta en Thunar (revertir: xfconf-query -c $XFCONF_CHANNEL -p $XFCONF_PROP -r)"
  else
    warn "no pude escribir $XFCONF_PROP; ocúltala a mano desde el panel de Thunar"
  fi
}

unhide_ugly_entry() {
  have xfconf-query || return 0
  xfconf-query -c "$XFCONF_CHANNEL" -p "$XFCONF_PROP" -r >/dev/null 2>&1 || true
}

# --------------------------------- 9. abrir ---------------------------------
open_thunar() {
  step "9. Abriendo Thunar"
  if have hyprctl; then
    info "workspace activo: $(hyprctl activeworkspace 2>/dev/null | awk '/workspace ID/{print $3}')"
  fi
  thunar "$URI" >/dev/null 2>&1 &
  sleep 1
  ok "Thunar -> $URI"
}

report() {
  step "Estado final"
  printf '  %-14s %s\n' "URI:" "$URI"
  printf '  %-14s %s\n' "alias:" "$HOST_ALIAS -> $HOST_IP"
  printf '  %-14s %s\n' "montaje:" "$(gio mount -l 2>/dev/null | grep -F -- "-> $ROOT_URI" | head -1 | sed 's/^Mount([0-9]*): //')"
  printf '  %-14s %s\n' "bookmark:" "$(grep -F "$URI" "$BOOKMARKS_FILE" 2>/dev/null | head -1)"
  if have xfconf-query && xfconf-query -c "$XFCONF_CHANNEL" -p "$XFCONF_PROP" >/dev/null 2>&1; then
    printf '  %-14s %s\n' "ocultos:" "$(hidden_devices_list | tr '\n' ', ')"
  fi
}

do_unmount() {
  step "Desmontando"
  if already_mounted; then
    gio mount -u "$ROOT_URI" >/dev/null 2>&1 && ok "desmontado $ROOT_URI"
  else
    info "no estaba montado"
  fi
  if [ -e "$BOOKMARKS_FILE" ]; then
    local tmp; tmp="$(mktemp)"
    awk -v u="$URI" 'index($0, u) != 1' "$BOOKMARKS_FILE" > "$tmp"
    mv "$tmp" "$BOOKMARKS_FILE"
    ok "bookmark eliminado"
  fi
  unhide_ugly_entry
  ok "entrada del panel restaurada"
  exit 0
}

# ---------------------------------- main ------------------------------------
[ "$MODE" = unmount ] && do_unmount

if [ "$MODE" = status ]; then
  check_deps
  check_hosts
  check_hostkey
  check_ssh
  if already_mounted; then ok "MONTADO"; else warn "no montado (ejecuta sin --status)"; fi
  report
  exit 0
fi

check_deps
check_hosts
check_hostkey
check_ssh
do_mount
verify_mount
ensure_bookmark
[ "$DO_HIDE" -eq 1 ] && hide_ugly_entry
[ "$DO_OPEN" -eq 1 ] && open_thunar
report

printf '\n%sListo:%s abre Thunar y verás el bookmark "%s" en el panel izquierdo.\n' "$C_G" "$C_0" "$BOOKMARK_NAME"
